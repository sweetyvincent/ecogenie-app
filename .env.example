# ================================================
# ECOGENIE - Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# ─── Application ────────────────────────────────
ENVIRONMENT=development
APP_NAME=EcoGenie
APP_VERSION=1.0.0

# ─── Ports ──────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

# ─── Database ──────────────────────────────────
DB_USER=ecogenie
DB_PASSWORD=ecogenie_pass
DB_NAME=ecogenie_db
DATABASE_URL=postgresql://ecogenie:ecogenie_pass@localhost:5432/ecogenie_db

# ─── Authentication ────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─── OpenAI (for CarbonGPT) ───────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# ─── AWS S3 (for file uploads) ─────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ecogenie-uploads

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ─── Clerk Authentication (Production) ─────────
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret

# ─── Pinecone (Vector Database) ────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=ecogenie-embeddings

# ─── Email (Notifications) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ─── Analytics ─────────────────────────────────
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token
